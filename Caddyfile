
# TLS is terminated by the external reverse proxy.
# This Caddy instance serves HTTP only on port 80.

:80 {
    encode zstd gzip

    header -Server

    # Game server: REST API, health endpoint and WebSocket.
    @backend path /ws /api /api/* /health
    handle @backend {
        reverse_proxy server:3000
    }

    # Static frontend / SPA.
    handle {
        root * /srv

        # Vite's hashed assets can be cached permanently.
        @hashed path /assets/*
        header @hashed Cache-Control "public, max-age=31536000, immutable"

        # Route frontend paths to the SPA entry point.
        try_files {path} /index.html
        file_server
    }
}
