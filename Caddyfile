# Everything goes through 443 (school networks block unusual ports; wss needs TLS).
# DOMAIN defaults to localhost, for which Caddy issues a locally trusted certificate.
{$DOMAIN:localhost} {
	encode zstd gzip

	# Game socket and REST API go to the Bun server.
	@backend path /ws /api/* /health
	handle @backend {
		reverse_proxy server:3000
	}

	handle {
		root * /srv
		# Hashed build assets (js, css, fonts) never change; everything else must revalidate,
		# including the audio files in /assets/audio, whose names carry no hash.
		@hashed path_regexp hashed ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header -Server
		try_files {path} /index.html
		file_server
	}
}
