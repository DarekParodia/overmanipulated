# TLS is terminated by the external reverse proxy (everything reaches players over 443: school
# networks block unusual ports, and wss needs TLS). This Caddy instance serves plain HTTP on :80
# and is published on host port 8080 for that proxy; the proxy must forward WebSocket upgrades
# and the original Host header.
# Access logs are off on purpose (no IP addresses stored); see docs/deploy.md to switch them on.
:80 {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# 'unsafe-inline' for styles only: React inline style attributes. Scripts are same-origin
		# only. wss: is listed next to 'self' because older Safari versions do not
		# match 'self' against ws(s) URLs, and behind an external proxy the Host seen here may not
		# be the public name. blob:/data: serve canvas textures and decoded audio.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob: data:; connect-src 'self' wss:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# Game socket and REST API go to the Bun server. WebSocket upgrades pass through untouched;
	# there is no idle timeout on a proxied socket, the client's 2 s heartbeat and the server's
	# own pings keep NATs and proxies awake.
	@backend path /ws /api /api/* /health
	handle @backend {
		header Cache-Control "no-store"
		request_body {
			max_size 8KB
		}
		reverse_proxy server:3000 {
			transport http {
				dial_timeout 3s
				response_header_timeout 15s
			}
			health_uri /health
			health_interval 5s
			health_timeout 2s
			# Keep running matches alive across a Caddy config reload.
			stream_close_delay 5m
		}
	}

	# Build output. Names carry a content hash, so they never change: cache for a year. A missing
	# file under /assets is a real 404, never the SPA fallback (a stale tab asking for an old hash
	# must not get index.html cached as "immutable"). Audio files have no hash: always revalidate.
	handle /assets/* {
		root * /srv
		@hashed {
			path_regexp hashed ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2)$
			file {path}
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Everything else under /assets, and any 404, is never cached for long.
		@other not {
			path_regexp hashed ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2)$
		}
		header @other Cache-Control "no-cache"
		# Brotli files are produced at image build time (tools/deploy/precompress.ts).
		file_server {
			precompressed br
		}
	}

	# index.html, manifest, icons: revalidate on every load (ETag makes that cheap).
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server {
			precompressed br
		}
	}
}
