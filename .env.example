# Copy to .env next to docker-compose.yml. Every variable is optional for a local trial.

# Public host name for Caddy's automatic HTTPS (Let's Encrypt). Its DNS record must point at
# this machine and ports 80 and 443 must be reachable. Leave as "localhost" to try the stack
# on your own computer (Caddy then issues a locally trusted certificate).
DOMAIN=localhost

# Server log verbosity: info (default) or silent. Logs are one JSON line per event; they hold
# room codes and event names, never nicknames or addresses.
LOG_LEVEL=info
