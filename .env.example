# Copy to .env next to docker-compose.yml. Every variable is optional for a local trial.
# TLS and the public host name live in the external reverse proxy; features, the message of the
# day and ads live in config/config.json (copy config/config.example.json; see docs/deploy.md).

# Server log verbosity: info (default) or silent. Logs are one JSON line per event; they hold
# room codes and event names, never nicknames or addresses.
LOG_LEVEL=info

# Addresses of the external TLS proxy, whose X-Forwarded-For header Caddy believes when it works
# out the player's address for the per-address abuse limits: IPs or CIDR ranges (several in
# quotes, separated by spaces). private_ranges (default) fits a proxy on this same host; a proxy
# on another machine needs its own address, e.g. TRUSTED_PROXIES=203.0.113.4/32.
# See docs/deploy.md ("Client address").
TRUSTED_PROXIES=private_ranges

# Ads kill switch: false turns ads off whatever config/config.json says (also across config
# reloads). Leave it unset to let config.json decide; true cannot bypass the ads.signOff rule.
# ADS_ENABLED=false

# --- Running the server without Docker -------------------------------------------------------
# Bun reads this .env itself when the server starts from the repository root
# (`bun apps/server/src/index.ts`). docker-compose.yml fixes these in the container instead, so
# they have no effect there. Defaults are relative to the repository (docs/deploy.md
# "Environment variables").
# PORT=3000
# DATABASE_PATH=./data/redakcja.sqlite
# CONFIG_PATH=config/config.json
# SHELL_HTML_PATH=apps/client/dist/index.html
# PRIVACY_MD_PATH=docs/privacy.pl.md
# BRIEFING_MS=18000
# DEV_LATENCY_MS=0
